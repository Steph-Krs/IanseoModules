    {
        "id": "has_8_archers_same_category",
        "label": {
            "fr": "Au moins 8 archers d'une même catégorie, inscrits aux épreuves individuelles et avec un score",
            "en": "At least 8 archers of one and the same category, entered in the individual events and with a score",
            "it": "Almeno 8 arcieri di una stessa classe, iscritti agli eventi individuali e con un punteggio",
            "de": "Mindestens 8 Schützen einer Klasse, für die Einzelbegegnungen gemeldet und mit einem Ergebnis",
            "es": "Al menos 8 arqueros de una misma clase, inscritos en las pruebas individuales y con puntuación"
        },
        "checks": [
            {
                "source": "session",
                "key": "TourId",
                "op": "gt",
                "value": 0
            },
            {
                "table": "Entries",
                "aggregate": "max_group",
                "join": {
                    "table": "Qualifications",
                    "on": "QuId = EnId"
                },
                "group_by": [
                    "EnDivision",
                    "EnClass"
                ],
                "where": [
                    {
                        "column": "EnTournament",
                        "source": "session",
                        "key": "TourId"
                    },
                    {
                        "column": "EnAthlete",
                        "op": "eq",
                        "value": "1"
                    },
                    {
                        "column": "EnIndFEvent",
                        "op": "eq",
                        "value": "1"
                    },
                    {
                        "column": "QuScore",
                        "op": "gt",
                        "value": "0"
                    }
                ],
                "op": "gte",
                "value": 8
            }
        ]
    },
