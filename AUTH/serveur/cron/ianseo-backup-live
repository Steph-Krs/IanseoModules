# /etc/cron.d/ianseo-backup-live — "live" copies of the database, site open.
#
# root:root, chmod 0644. Same traps as ianseo-nightly: file name WITHOUT a dot, final LINE
# FEED mandatory, USER field (7 fields).
#
# With the nightly backup of 03:15, one copy every 6 hours: 09:05, 15:05, 21:05.
# Database only, without the logos (default setting): on the first server, 2.6 s and 4.1 MB.
# --single-transaction on InnoDB tables: no table locked, no page of the site waits for the
# copy; "nice" leaves it the processor priority.
# The copy skips itself during the maintenance window or a restore.
# Sent online when an online copy is configured (same destination as the night).
#
# Suspend without touching the server: Multi-account hosting › Server configuration › Live copies.
# Log: /var/log/ianseo-backup.log (to create once, see serveur/README.md).

SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

5 9,15,21 * * * www-data nice -n 10 /usr/bin/php /var/www/ianseo/Modules/Custom/AUTH/cron/backup.php --live >> /var/log/ianseo-backup.log 2>&1
