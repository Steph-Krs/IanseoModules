# /etc/cron.d/ianseo-waitlist — waiting lists of the online registration.
#
# root:root, chmod 0644. Same traps as ianseo-nightly: file name WITHOUT a dot, final LINE
# FEED mandatory, USER field (7 fields).
#
# Registers the first archer of a waiting list when a place was freed by the screens of ianseo
# itself (participant deleted, targets added): the online registration pages already do it
# when the place is freed through them or when they are opened. Every 10 minutes, a few
# milliseconds when nobody waits; only writes to the log when an archer was registered. Steps
# aside by itself during the nightly maintenance window and during a restore.

SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

*/10 * * * * www-data /usr/bin/php /var/www/ianseo/Modules/Custom/AUTH/cron/waitlist.php >> /var/log/ianseo-maintenance.log 2>&1
