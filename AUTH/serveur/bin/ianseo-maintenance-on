#!/bin/sh
# ianseo-maintenance-on — puts the site in maintenance (503 page).
#
# To install as /usr/local/bin/ianseo-maintenance-on (root, chmod 750).
#
# Only sets a flag file: it is APACHE that really blocks the traffic and serves the page (see
# apache/ianseo-ssl.conf, RewriteCond block). The module therefore has no power over the web
# server beyond this file.
#
# Called automatically by cron/maintenance.php, which guarantees the exit from maintenance
# even on error. Can also be used by hand.
set -e

FLAG=/var/www/maintenance.flag

touch "$FLAG"
echo "$(date): maintenance on"
