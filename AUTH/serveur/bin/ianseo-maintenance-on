#!/bin/sh
# ianseo-maintenance-on — met le site en maintenance (page 503).
#
# À installer dans /usr/local/bin/ianseo-maintenance-on (root, chmod 750).
#
# Ne fait que poser un fichier drapeau : c'est APACHE qui bloque réellement le
# trafic et sert la page (voir apache/ianseo-ssl.conf, bloc RewriteCond). Le
# module n'a donc aucun pouvoir sur le serveur web au-delà de ce fichier.
#
# Appelé automatiquement par cron/maintenance.php, qui garantit la sortie de
# maintenance même en cas d'erreur. Utilisable aussi à la main.
set -e

FLAG=/var/www/maintenance.flag

touch "$FLAG"
echo "$(date): maintenance activée"
