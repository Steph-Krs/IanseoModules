#!/bin/sh
# ianseo-unlock — opens the ianseo core for writing, TEMPORARILY.
#
# To install as /usr/local/bin/ianseo-unlock (root, chmod 750).
#
# ⚠️ A deliberately TRANSIENT state: only for the time of a core update, then run `ianseo-lock`
# at once. Leaving the server unlocked cancels the main protection against a flaw of the core.
#
# The automated update (cron/maintenance.php, "core" step) already frames the operation:
# unlock → update → lock.
set -e

IANSEO=/var/www/ianseo
WEBUSER=www-data

chown -R ${WEBUSER}:${WEBUSER} "$IANSEO"
find "$IANSEO" -type d -exec chmod 770 {} \;
find "$IANSEO" -type f -exec chmod 660 {} \;

echo "ianseo unlocked for an update — remember to run ianseo-lock afterwards."
