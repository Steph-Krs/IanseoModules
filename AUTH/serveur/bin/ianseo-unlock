#!/bin/sh
# ianseo-unlock — ouvre TEMPORAIREMENT le cœur ianseo en écriture.
#
# À installer dans /usr/local/bin/ianseo-unlock (root, chmod 750).
#
# ⚠️ État volontairement TRANSITOIRE : à n'utiliser que le temps d'une mise à
# jour du cœur, puis relancer immédiatement `ianseo-lock`. Laisser le serveur
# déverrouillé annule la principale protection contre une faille du cœur.
#
# La mise à jour automatisée (cron/maintenance.php, étape « cœur ») encadre déjà
# l'opération : unlock → mise à jour → lock.
set -e

IANSEO=/var/www/ianseo
WEBUSER=www-data

chown -R ${WEBUSER}:${WEBUSER} "$IANSEO"
find "$IANSEO" -type d -exec chmod 770 {} \;
find "$IANSEO" -type f -exec chmod 660 {} \;

echo "ianseo déverrouillé pour mise à jour — pense à relancer ianseo-lock après."
