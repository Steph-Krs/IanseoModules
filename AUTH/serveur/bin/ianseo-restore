#!/bin/bash
# ianseo-restore — restores a backup of the AUTH module (database or files).
#
# To install as /usr/local/bin/ianseo-restore (root:root, chmod 750). To run as root.
#
#   sudo ianseo-restore                   lists the available backups
#   sudo ianseo-restore --test FILE       CHECKS a copy without touching the site: the database is
#                                         restored into a throwaway database, counted, then deleted
#   sudo ianseo-restore FILE              restores for real (database or files, from the name)
#
# FILE: a name from the list (ianseo-db-…, ianseo-live-…, ianseo-files-…) or a path (for
# instance a copy brought back from the online backup with "rclone copy").
#
# ⚠ Restoring the DATABASE brings EVERY competition of the server back to the time of the copy:
#   everything typed since is lost, for everyone.
#
# Steps of a real restore:
#   1. confirmation (type YES);
#   2. lock shared with the nightly maintenance: neither it nor the live copies start;
#   3. site in maintenance (503 page);
#   4. safety copy of the current state — going back to it may be wanted;
#   5. restore; for the files, the core is then put back to read only;
#   6. site reopened.
# When the restore itself fails, the site STAYS CLOSED: a half-restored database must not be
# served. The message tells what to do.
set -euo pipefail

IANSEO=/var/www/ianseo
DB=ianseo
DIR=/var/backups/ianseo
WEBUSER=www-data
PHP=/usr/bin/php
TESTDB=ianseo_restore_test

AUTH="$IANSEO/Modules/Custom/AUTH"
ON=/usr/local/bin/ianseo-maintenance-on
OFF=/usr/local/bin/ianseo-maintenance-off
RELOCK=/usr/local/bin/ianseo-lock
PATTERN='^ianseo-(db|live|files)-[0-9]{8}-[0-9]{6}\.(sql|tar)\.gz$'

STAGE=""
WORK=""
RESTORE_FILE=""

die() { echo "ERROR: $*" >&2; exit 1; }

list() {
    echo "Backups in $DIR (newest first):"
    { ls -1t "$DIR" 2>/dev/null || true; } | { grep -E "$PATTERN" || true; } | while read -r f; do
        printf '  %6s  %s\n' "$(du -h "$DIR/$f" | cut -f1)" "$f"
    done
    echo
    echo "  ianseo-db-…     database, taken every night with the site closed"
    echo "  ianseo-live-…   database, live copy (site open)"
    echo "  ianseo-files-…  files of the site (code + modules), same night as the ianseo-db-… of the same time stamp"
    echo
    echo "Check a copy:  sudo ianseo-restore --test FILE"
    echo "Restore:       sudo ianseo-restore FILE"
}

# Name or path → full path of a backup of the module (refuses any other file).
resolve() {
    local f="$1"
    [ -f "$f" ] || f="$DIR/$(basename -- "$1")"
    [ -f "$f" ] || die "file not found: $1"
    basename -- "$f" | grep -qE "$PATTERN" || die "this is not a backup of the module: $(basename -- "$f")"
    echo "$f"
}

test_copy() {
    local f
    f=$(resolve "$1")
    case "$f" in
    *.tar.gz)
        echo "Reading the archive $(basename -- "$f")…"
        local n
        n=$(tar -tzf "$f" | wc -l) || die "archive cannot be read."
        echo "OK: archive readable, $n entries."
        ;;
    *)
        echo "Trial restore of $(basename -- "$f") into the throwaway database $TESTDB (the site is not touched)…"
        mysql -e "DROP DATABASE IF EXISTS \`$TESTDB\`; CREATE DATABASE \`$TESTDB\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
        trap 'mysql -e "DROP DATABASE IF EXISTS \`$TESTDB\`;" || true' EXIT
        gunzip -c "$f" | mysql "$TESTDB" || die "this copy does not restore (error above)."
        echo "OK: $(mysql -N -e "SELECT COUNT(*) FROM information_schema.TABLES WHERE TABLE_SCHEMA = '$TESTDB'") tables," \
             "$(mysql -N "$TESTDB" -e 'SELECT COUNT(*) FROM Tournament') competitions," \
             "$(mysql -N "$TESTDB" -e 'SELECT COUNT(*) FROM Entries') entries."
        echo "Most recent competitions of this copy:"
        mysql -N "$TESTDB" -e "SELECT CONCAT('  ', ToCode, '  ', ToWhenFrom, '  ', ToName) FROM Tournament ORDER BY ToWhenFrom DESC LIMIT 5"
        echo "(throwaway database deleted)"
        ;;
    esac
}

# Copies taken before AUTH 1.2.0 name the module tables AUT_* and BK_*. Since 1.2.0 those names
# are views over the renamed tables (Auth*, Booking*), and the DROP TABLE of such a copy cannot
# remove a view: its CREATE TABLE would then fail. So the views go first and, for such a copy,
# the renamed tables too, so that the database ends up exactly as the copy; cron/schema.php
# migrates it again afterwards. The club logos stay unless the copy holds them (a copy without
# logos only carries their empty structure).
NEW_TABLES="AuthUsers AuthShare AuthShareClub AuthClaim AuthLog AuthSessions AuthTickets AuthUsage
AuthUsageSeen AuthClubLogos BookingArchers BookingSessions BookingLog BookingCompetitions
BookingRegistrations BookingTargetCaps BookingClubManagers BookingShopItems BookingShopVariants
BookingShopOrders BookingPayments BookingReimportConflicts BookingSurveys BookingSurveyVoters
BookingWaitlist BookingRefunds BookingLedger"

prepare_database() {
    local f="$1" t keep=AuthClubLogos
    for t in $(mysql -N "$DB" -e "SELECT TABLE_NAME FROM information_schema.TABLES
            WHERE TABLE_SCHEMA = DATABASE() AND TABLE_TYPE = 'VIEW'
              AND (TABLE_NAME LIKE 'AUT\\_%' OR TABLE_NAME LIKE 'BK\\_%')"); do
        mysql "$DB" -e "DROP VIEW \`$t\`"
    done
    # "|| true": grep stops reading at the first match, which would fail gunzip under pipefail.
    { gunzip -c "$f" || true; } | grep -q '^CREATE TABLE `AUT_Users`' || return 0
    echo "Copy taken before AUTH 1.2.0: restored under its table names, then migrated."
    if { gunzip -c "$f" || true; } | grep -q '^INSERT INTO `AUT_ClubLogos`'; then keep=""; fi
    for t in $NEW_TABLES; do
        [ "$t" = "$keep" ] && continue
        mysql "$DB" -e "DROP TABLE IF EXISTS \`$t\`"
    done
}

on_exit() {
    local rc=$?
    [ -n "$WORK" ] && rm -f -- "$WORK"
    case "$STAGE" in
    closed)
        "$OFF" || true
        echo "Site reopened: nothing was restored."
        ;;
    restoring)
        echo
        echo "!! FAILURE DURING THE RESTORE (code $rc): the site stays CLOSED (maintenance page)."
        echo "   Start again:                  sudo ianseo-restore $(basename -- "$RESTORE_FILE")"
        echo "   Go back to the state before:  sudo ianseo-restore <safety copy, at the top of \"sudo ianseo-restore\">"
        echo "   Reopen the site anyway:       sudo $OFF"
        ;;
    esac
}

restore() {
    local f kind answer
    f=$(resolve "$1")
    RESTORE_FILE="$f"
    kind=database
    case "$f" in *.tar.gz) kind=files ;; esac

    echo "Restoring: $(basename -- "$f")"
    if [ "$kind" = database ]; then
        echo "⚠ EVERY competition of the server goes back to the time of this copy."
        echo "  Everything typed since will be lost, for everyone."
    else
        echo "⚠ The files of the site (code + modules) go back to the time of this copy."
        echo "  To do with the database of the same night (the ianseo-db-… of the same time stamp)."
    fi
    printf 'Type YES to go on: '
    read -r answer || true
    [ "$answer" = "YES" ] || { echo "Cancelled: nothing was changed."; exit 1; }

    # 2. Same lock as cron/maintenance.php; the live copies test it and step aside.
    #    Created for the web user if missing: a root-owned lock would block the nights.
    local lockfile="$AUTH/cron/.maintenance.lock"
    [ -e "$lockfile" ] || install -o "$WEBUSER" -g "$WEBUSER" -m 0644 /dev/null "$lockfile"
    exec 9<"$lockfile"
    flock -n 9 || die "a nightly maintenance is running: try again once it is over."
    trap on_exit EXIT
    trap 'exit 130' INT TERM

    # The copy to restore gets a second name the rotation never touches: the safety copy
    # below rotates old backups, and could otherwise delete the very file being restored.
    WORK="$(dirname -- "$f")/.restore-$$.gz"
    ln -- "$f" "$WORK" 2>/dev/null || cp -- "$f" "$WORK"

    # 3. Site closed. Until the restore itself starts, any exit reopens it.
    STAGE=closed
    "$ON"

    # 4. Safety copy of the current state.
    echo "Safety copy of the current state…"
    if ! su -s /bin/sh "$WEBUSER" -c "$PHP $AUTH/cron/backup.php --local"; then
        echo "⚠ The safety copy failed (database possibly damaged)."
        printf 'Type CONTINUE to restore anyway, anything else to cancel: '
        read -r answer || true
        [ "$answer" = "CONTINUE" ] || exit 1
    fi

    # 5. Restore.
    STAGE=restoring
    if [ "$kind" = database ]; then
        prepare_database "$WORK"
        gunzip -c "$WORK" | mysql "$DB"
        # Tables brought to the names of the module in place, before the site reopens: the open
        # sessions would not check them again. Absent when the files restored are older.
        if [ -f "$AUTH/cron/schema.php" ]; then
            su -s /bin/sh "$WEBUSER" -c "$PHP $AUTH/cron/schema.php"
        fi
    else
        tar -xzf "$WORK" -C "$(dirname -- "$IANSEO")"
        [ -x "$RELOCK" ] && "$RELOCK"
    fi
    STAGE=done

    # 6. Site reopened.
    "$OFF"
    echo "Restore done, site reopened."
    if [ "$kind" = database ] && [ "$(mysql -N "$DB" -e 'SELECT COUNT(*) FROM Flags' 2>/dev/null || echo 0)" = "0" ]; then
        echo "Club logos missing (a copy without logos restored on a new server): they come back with the"
        echo "sync of the night, or right now: sudo -u $WEBUSER $PHP $AUTH/cron/sync-logos.php --full"
    fi
}

[ "$(id -u)" -eq 0 ] || die "to run as root (sudo ianseo-restore …)."

case "${1:-}" in
    "")        list ;;
    -h|--help) sed -n '2,25p' "$0" ;;
    --test)    [ -n "${2:-}" ] || die "give the file to check."; test_copy "$2" ;;
    -*)        die "unknown option: $1 (see --help)" ;;
    *)         restore "$1" ;;
esac
