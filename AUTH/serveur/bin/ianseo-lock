#!/bin/sh
# ianseo-lock — remet le cœur ianseo en LECTURE SEULE pour le serveur web.
#
# À installer dans /usr/local/bin/ianseo-lock (root, chmod 750).
# C'est l'état NORMAL du serveur : le compte web ne doit pas pouvoir réécrire le
# code de ianseo, afin qu'une faille du cœur ne se transforme pas en prise de
# contrôle durable. Les dossiers qui ont RÉELLEMENT besoin d'écriture sont
# ré-ouverts un par un ci-dessous — ni plus, ni moins.
#
# Voir ianseo-unlock pour l'opération inverse (mise à jour du cœur uniquement).
set -e

IANSEO=/var/www/ianseo
WEBUSER=www-data

# 1. Tout appartient à root, le groupe web n'a que la lecture.
chown -R root:${WEBUSER} "$IANSEO"

# 2. Exception : les modules tiers, mis à jour depuis leur page d'administration
#    (et par le cron de maintenance) — ils doivent rester écrivables en permanence.
chown -R ${WEBUSER}:${WEBUSER} "$IANSEO/Modules/Custom"

# 3. Droits de base : lecture seule pour le groupe (Modules/Custom exclu).
find "$IANSEO" -path "$IANSEO/Modules/Custom" -prune -o -type d -exec chmod 750 {} \;
find "$IANSEO" -path "$IANSEO/Modules/Custom" -prune -o -type f -exec chmod 640 {} \;

# 4. Sticky bit (1770) là où le serveur web doit pouvoir CRÉER des entrées sans
#    pouvoir toucher à celles de root :
#      - la racine : création de TourData/ à la volée par ianseo ;
#      - Install/  : fichiers temporaires d'installation ;
#      - Modules/  : indispensable à l'auto-réparation AUTH-SELFHEAL, qui doit
#                    pouvoir RECRÉER Modules/Authentication/ après une mise à
#                    jour du cœur qui l'a effacé.
chmod 1770 "$IANSEO" "$IANSEO/Install" "$IANSEO/Modules"

# 5. Dossiers de DONNÉES, écrivables en permanence par le serveur web.
#    ⚠️ TV/ est indispensable : ianseo y écrit les drapeaux/logos de club, les
#    photos d'archers et les images de badges, et la page /Update/ REFUSE de
#    démarrer si TV/Photos n'est pas inscriptible (« DirectoryNotWriteable »).
for d in Images Common TV TourData; do
    [ -d "$IANSEO/$d" ] || continue
    chown -R ${WEBUSER}:${WEBUSER} "$IANSEO/$d"
    find "$IANSEO/$d" -type d -exec chmod 770 {} \;
done

# 6. Fichiers d'authentification déployés : recréés par AUTH après chaque mise à
#    jour du cœur, ils doivent appartenir au serveur web.
if [ -d "$IANSEO/Modules/Authentication" ]; then
    chown -R ${WEBUSER}:${WEBUSER} "$IANSEO/Modules/Authentication"
    chmod 770 "$IANSEO/Modules/Authentication"
fi

# 7. Le fichier de configuration local du module contient des identifiants :
#    lisible par le seul serveur web.
if [ -f "$IANSEO/Modules/Custom/AUTH/config.local.json" ]; then
    chown ${WEBUSER}:${WEBUSER} "$IANSEO/Modules/Custom/AUTH/config.local.json"
    chmod 600 "$IANSEO/Modules/Custom/AUTH/config.local.json"
fi

echo "ianseo reverrouillé."
