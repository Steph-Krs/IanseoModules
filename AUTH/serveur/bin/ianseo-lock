#!/bin/sh
# ianseo-lock — puts the ianseo core back to READ ONLY for the web server.
#
# To install as /usr/local/bin/ianseo-lock (root, chmod 750).
# This is the NORMAL state of the server: the web account must not be able to rewrite the
# ianseo code, so that a flaw of the core does not turn into a lasting take-over. The folders
# that REALLY need writing are opened again one by one below — no more, no less.
#
# See ianseo-unlock for the opposite operation (core update only).
set -e

IANSEO=/var/www/ianseo
WEBUSER=www-data

# 1. Everything belongs to root, the web group can only read.
chown -R root:${WEBUSER} "$IANSEO"

# 2. Exception: the third-party modules, updated from their administration page (and by the
#    maintenance cron) — they must stay writable at all times.
chown -R ${WEBUSER}:${WEBUSER} "$IANSEO/Modules/Custom"

# 3. Base rights: read only for the group (Modules/Custom excluded).
find "$IANSEO" -path "$IANSEO/Modules/Custom" -prune -o -type d -exec chmod 750 {} \;
find "$IANSEO" -path "$IANSEO/Modules/Custom" -prune -o -type f -exec chmod 640 {} \;

# 4. Sticky bit (1770) where the web server must be able to CREATE entries without being
#    able to touch root's:
#      - the root folder: TourData/ created on the fly by ianseo;
#      - Install/: temporary installation files;
#      - Modules/: required by the AUTH-SELFHEAL self-repair, which must be able to
#                  CREATE Modules/Authentication/ AGAIN after a core update erased it.
chmod 1770 "$IANSEO" "$IANSEO/Install" "$IANSEO/Modules"

# 5. DATA folders, writable by the web server at all times.
#    ⚠️ TV/ is required: ianseo writes the club flags/logos, the archer photos and the badge
#    images there, and the /Update/ page REFUSES to start when TV/Photos is not writable
#    ("DirectoryNotWriteable").
for d in Images Common TV TourData; do
    [ -d "$IANSEO/$d" ] || continue
    chown -R ${WEBUSER}:${WEBUSER} "$IANSEO/$d"
    find "$IANSEO/$d" -type d -exec chmod 770 {} \;
done

# 6. Deployed authentication files: created again by AUTH after each core update, they must
#    belong to the web server.
if [ -d "$IANSEO/Modules/Authentication" ]; then
    chown -R ${WEBUSER}:${WEBUSER} "$IANSEO/Modules/Authentication"
    chmod 770 "$IANSEO/Modules/Authentication"
fi

# 7. The local configuration file of the module holds credentials: readable by the web
#    server alone.
if [ -f "$IANSEO/Modules/Custom/AUTH/config.local.json" ]; then
    chown ${WEBUSER}:${WEBUSER} "$IANSEO/Modules/Custom/AUTH/config.local.json"
    chmod 600 "$IANSEO/Modules/Custom/AUTH/config.local.json"
fi

echo "ianseo locked again."
