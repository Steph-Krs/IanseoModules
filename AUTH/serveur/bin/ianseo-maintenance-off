#!/bin/sh
# ianseo-maintenance-off — puts the site back in service.
#
# To install as /usr/local/bin/ianseo-maintenance-off (root, chmod 750).
#
# Idempotent: does not complain when the flag is already gone — required, since
# cron/maintenance.php may call it several times (normal end AND safety net on an
# interruption).
#
# ⚠️ When the server stops abruptly DURING a maintenance window (power cut, kill -9), the flag
# may remain: the site then stays on the 503 page. Run this command by hand to take over again.
set -e

FLAG=/var/www/maintenance.flag

rm -f "$FLAG"
echo "$(date): maintenance off"
