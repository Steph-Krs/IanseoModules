#!/bin/sh
# ianseo-maintenance-off — remet le site en service.
#
# À installer dans /usr/local/bin/ianseo-maintenance-off (root, chmod 750).
#
# Idempotent : ne proteste pas si le drapeau est déjà absent — indispensable,
# car cron/maintenance.php peut l'appeler plusieurs fois (fin normale ET filet
# de sécurité en cas d'interruption).
#
# ⚠️ En cas d'arrêt brutal du serveur PENDANT une fenêtre de maintenance
# (coupure de courant, kill -9), le drapeau peut subsister : le site reste alors
# en page 503. Lancer cette commande à la main pour reprendre la main.
set -e

FLAG=/var/www/maintenance.flag

rm -f "$FLAG"
echo "$(date): maintenance désactivée"
