# MariaDB / MySQL settings of an online ianseo server — see SERVEUR.md § 6.3.
#
#   MariaDB: sudo install -m 0644 ianseo.cnf /etc/mysql/mariadb.conf.d/99-ianseo.cnf
#   MySQL 8: sudo install -m 0644 ianseo.cnf /etc/mysql/mysql.conf.d/99-ianseo.cnf
#   then   : sudo systemctl restart mariadb     (or mysql) — outside a competition
#
# Multi-account hosting › Server configuration › Server state tells what to adjust.
#
# ⚠ Do NOT add "optimizer_switch=derived_condition_pushdown=off" here: MariaDB does not know
#   this option and would refuse to start. Under MySQL 8 ONLY, once:
#   sudo mysql -e "SET PERSIST optimizer_switch='derived_condition_pushdown=off';"

[mysqld]
# ianseo opens TWO connections per page (reading + writing): at least 2 × the number of PHP
# processes (Apache MaxRequestWorkers, or pm.max_children with PHP-FPM), plus a margin.
# 320 = 2 × 150 (Debian's MaxRequestWorkers) + 20. Beyond it, the database refuses the
# connection and the user lands on an error page.
max_connections         = 320

# At least the size of the database; up to 50-70 % of the RAM on a machine dedicated to ianseo.
innodb_buffer_pool_size = 1G

# Queries of more than 2 s: this log names the query at fault when the server slows down.
# File: /var/lib/mysql/<server-name>-slow.log
slow_query_log          = 1
long_query_time         = 2
