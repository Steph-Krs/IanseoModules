# /etc/logrotate.d/ianseo — rotation of the module's logs.
#
#   sudo install -m 0644 -o root -g root ianseo /etc/logrotate.d/ianseo
#   sudo logrotate -d /etc/logrotate.d/ianseo    # -d = dry run, nothing is written
#
# Without rotation, /var/log/ianseo-maintenance.log grows for ever (the logo sync writes ~1600
# lines a night) and ianseo-auth.log even faster.

/var/log/ianseo-maintenance.log {
    weekly
    rotate 8
    compress
    delaycompress
    missingok
    notifempty
    create 0640 www-data adm
}

# Live copies of the database (cron/ianseo-backup-live): about ten lines per copy.
/var/log/ianseo-backup.log {
    monthly
    rotate 6
    compress
    delaycompress
    missingok
    notifempty
    create 0640 www-data adm
}

# Authentication log read by fail2ban.
# ⚠️ "copytruncate" and not "create": the module keeps the file open in append mode; a plain
# rename would make it write into the rotated file, and fail2ban would no longer see anything.
/var/log/ianseo-auth.log {
    weekly
    rotate 12
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    create 0640 www-data adm
}
