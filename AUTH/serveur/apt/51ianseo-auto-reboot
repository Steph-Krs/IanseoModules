// /etc/apt/apt.conf.d/51ianseo-auto-reboot — automatic restart, at night only.
//
// Some updates (kernel, base libraries) only take effect after a restart. Without this, the
// machine waits for someone to think of it; with it, it restarts at 04:45 — after the
// installation of 04:30 and the maintenance of 03:15, never in the daytime — and ONLY when an
// update requires it. Count one to two minutes of unavailability.
//
//   sudo install -m 0644 51ianseo-auto-reboot /etc/apt/apt.conf.d/51ianseo-auto-reboot
//
// To never restart by itself: do not install this file, and watch /var/run/reboot-required
// (present when a restart is pending).

Unattended-Upgrade::Automatic-Reboot "true";
Unattended-Upgrade::Automatic-Reboot-WithUsers "true";
Unattended-Upgrade::Automatic-Reboot-Time "04:45";
