# /etc/sudoers.d/ianseo-maintenance — minimal rights of the web account.
#
# Installation that MUST be checked (a syntax error in sudoers can make sudo unusable on the
# whole machine):
#   sudo install -m 0440 -o root -g root ianseo-maintenance /etc/sudoers.d/ianseo-maintenance
#   sudo visudo -c        # must print "parsed OK"
#
# Allows the maintenance cron (run as www-data) to switch the maintenance page. Nothing else:
# each command is named by its ABSOLUTE path, without wildcard, and without free argument.

www-data ALL=(root) NOPASSWD: /usr/local/bin/ianseo-maintenance-on, /usr/local/bin/ianseo-maintenance-off

# ---------------------------------------------------------------------------
# ianseo-unlock / ianseo-lock are NOT granted to www-data, and must not be: it would give the
# web account the power to make the WHOLE ianseo tree writable, hence to a flaw of the site
# the power to rewrite the code of the core — which cancels the protection given by
# ianseo-lock.
#
# The automatic core update does not need it: the cron line, started by root, unlocks before
# and locks again after the script (see serveur/cron/ianseo-nightly).
