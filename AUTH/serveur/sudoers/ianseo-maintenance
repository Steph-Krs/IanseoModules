# /etc/sudoers.d/ianseo-maintenance — droits minimaux du compte web.
#
# Installation OBLIGATOIREMENT vérifiée (une erreur de syntaxe dans sudoers peut
# rendre sudo inutilisable sur toute la machine) :
#   sudo install -m 0440 -o root -g root ianseo-maintenance /etc/sudoers.d/ianseo-maintenance
#   sudo visudo -c        # doit afficher « parsed OK »
#
# Permet au cron de maintenance (exécuté sous www-data) de basculer la page de
# maintenance. Rien d'autre : chaque commande est nommée par son chemin ABSOLU,
# sans joker, et sans argument libre.

www-data ALL=(root) NOPASSWD: /usr/local/bin/ianseo-maintenance-on, /usr/local/bin/ianseo-maintenance-off

# ---------------------------------------------------------------------------
# ianseo-unlock / ianseo-lock ne sont PAS accordés à www-data, et ne doivent pas
# l'être : ce serait donner au compte web le pouvoir de rendre TOUT l'arbre ianseo
# inscriptible, donc à une faille du site celui de réécrire le code du cœur — ce
# qui annule la protection apportée par ianseo-lock.
#
# La mise à jour automatique du cœur n'en a pas besoin : c'est la ligne cron,
# lancée par root, qui déverrouille avant et reverrouille après le script
# (voir serveur/cron/ianseo-nightly).
